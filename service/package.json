{
  "name": "afkdev",
  "version": "0.1.0",
  "description": "Daemon and CLI that owns Claude Code and Codex terminal sessions so they can be controlled remotely",
  "license": "MIT",
  "type": "module",
  "bin": {
    "afk": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "protocol:emit": "tsx src/protocol/emit-schema.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "commander": "^14.0.3",
    "koffi": "^3.3.6",
    "node-pty": "1.1.0",
    "pino": "^10.4.0",
    "ws": "^8.22.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
