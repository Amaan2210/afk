[*.{kt,kts}]
indent_size = 4
ktlint_code_style = android_studio
# Composable functions are named like types: PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.bat]
end_of_line = crlf

# Protocol enum entries keep the lowercase wire names.
[**/data/protocol/*.kt]
ktlint_standard_enum-entry-name-case = disabled
